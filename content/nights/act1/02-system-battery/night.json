    { "name": "Hours", "returns": "double", "params": [ { "name": "charge", "type": "int" }, { "name": "load", "type": "int" } ] },
    { "name": "Minutes", "returns": "int", "params": [ { "name": "hours", "type": "double" } ] },
    { "name": "LeftoverMinutes", "returns": "int", "params": [ { "name": "minutes", "type": "int" } ] }
