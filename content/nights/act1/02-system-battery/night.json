    { "method": "Hours", "args": [7, 2], "expected": 3.5, "hidden": true },
    { "method": "Minutes", "args": [1.5], "expected": 90 },
    { "method": "Minutes", "args": [0.25], "expected": 15 },
    { "method": "Minutes", "args": [1.999], "expected": 120, "hidden": true },
    { "method": "LeftoverMinutes", "args": [90], "expected": 30 },
    { "method": "LeftoverMinutes", "args": [125], "expected": 5 },
    { "method": "LeftoverMinutes", "args": [601], "expected": 1, "hidden": true }
