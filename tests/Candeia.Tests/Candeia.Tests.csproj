<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line test suites, without a test framework. See scripts/test.ps1 for how they run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Candeia.Tests</AssemblyName>
    <RootNamespace>Candeia.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Candeia.Core/Candeia.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference solutions of the nights: player code, compiled by the game at test time, never part of this project. -->
    <Compile Remove="Solutions/**" />
    <None Include="Solutions/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
